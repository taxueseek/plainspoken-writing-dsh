{
  "name": "plainspoken-writing-dsh",
  "version": "1.10.0",
  "type": "module",
  "description": "DeepSeek Harness (DSH) 白描写作协作模式插件：AI 味检测、机械预清理、改写质检与工作区规则注入",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./src/presets.ts",
      "default": "./dist/presets.js"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "default": "./dist/tools.js"
    },
    "./tool-surface": {
      "types": "./src/tool-surface.ts",
      "default": "./dist/tool-surface.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "default": "./dist/shared.js"
    },
    "./client": {
      "default": "./dist/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs && node ./scripts/build-client.mjs",
    "test": "node ./tests/verify-bundle.mjs",
    "sync-engine": "bash ./scripts/sync-engine.sh",
    "prepublishOnly": "node ./scripts/build.mjs && node ./scripts/build-client.mjs && node ./tests/verify-bundle.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "writing",
    "plainspoken",
    "baimiao",
    "humanize"
  ],
  "author": "taxueseek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/plainspoken-writing-dsh.git"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "src",
    "scripts",
    "tests",
    "engine"
  ]
}
